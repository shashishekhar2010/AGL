# =============================================================================
# GitHub Pages Frontend Build Variables
# Set these in GitHub: Repository Settings -> Secrets and variables -> Actions -> Variables
# =============================================================================

# VITE_BASE_PATH: Automatically computed by .github/workflows/deploy-github-pages.yml
# (set to "/" for custom domains or <username>.github.io repos, or "/<repo-name>/" for project pages).
VITE_BASE_PATH="/"

# VITE_API_BASE_URL: Optional URL of your hosted Node backend (server.ts) so the static
# GitHub Pages website can use /admin login, Enquiries inbox, Team Chat, and Meetings.
# Example: https://alorix-backend.onrender.com (leave empty when frontend & backend share one origin).
VITE_API_BASE_URL=""

# =============================================================================
# Node Backend (server.ts) Environment Variables
# =============================================================================

# CORS_ORIGIN: Comma-separated allowed frontend origins when hosting server.ts separately
# from GitHub Pages (e.g. "https://yourusername.github.io,https://alorixglobal.com").
CORS_ORIGIN=""

# GEMINI_API_KEY / API_KEY: Optional server-side API key.
GEMINI_API_KEY=""

# APP_URL: Public URL where this website is hosted.
APP_URL=""

# RESEND_API_KEY & ENQUIRY_TO_EMAIL: Optional Resend email dispatch for business enquiries.
RESEND_API_KEY=""
ENQUIRY_TO_EMAIL=""

# ENQUIRY_WEBHOOK_URL: Optional webhook URL (Zapier, Make, Slack, CRM) for enquiries.
ENQUIRY_WEBHOOK_URL=""

# ADMIN_SESSION_SECRET: Recommended strong random secret so /admin sessions persist across restarts.
ADMIN_SESSION_SECRET=""

# Optional overrides for default /admin credentials:
SUPER_ADMIN_USERNAME=""
SUPER_ADMIN_PASSWORD=""
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
